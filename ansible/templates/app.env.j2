# Ansible이 생성한 파일입니다. 직접 수정하지 말고 group_vars를 고친 뒤 server.yml을 다시 실행하세요.
SPRING_PROFILES_ACTIVE={{ spring_profile }}
TZ=Asia/Seoul

# --- DB: 계정 B의 RDS PostgreSQL ---
SPRING_DATASOURCE_URL={{ db_jdbc_url }}
SPRING_DATASOURCE_USERNAME={{ db_user }}
SPRING_DATASOURCE_PASSWORD={{ db_password }}

# --- 인증 ---
JWT_SECRET={{ jwt_secret }}
VERIFICATION_SECRET={{ verification_secret }}
COOKIE_SECURE={{ cookie_secure }}
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins | join(',') }}

# --- 인증 메일 (Gmail SMTP) ---
MAIL_USERNAME={{ mail_username }}
MAIL_PASSWORD={{ mail_password }}

# --- 소셜 로그인 (비어 있는 제공자는 로그인 시 503) ---
OAUTH_REDIRECT_BASE_URI={{ oauth_redirect_base_uri }}
KAKAO_CLIENT_ID={{ kakao_client_id }}
KAKAO_CLIENT_SECRET={{ kakao_client_secret }}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
NAVER_CLIENT_ID={{ naver_client_id }}
NAVER_CLIENT_SECRET={{ naver_client_secret }}

# --- 가상 착장 (Decart). 키가 비어 있으면 착장 세션 생성 불가 ---
DECART_API_KEY={{ decart_api_key }}
# Decart 세션 제한의 실제 영상 · 과금 종료를 검증하기 전에는 false (false 면 세션 차단)
DECART_SESSION_LIMIT_VERIFIED={{ decart_session_limit_verified }}

# --- Redis (같은 compose 네트워크의 redis 컨테이너) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}

# --- AI 서버 (같은 compose 네트워크 내부 호출) ---
AI_BASE_URL={{ ai_base_url }}

# --- 이미지: 계정 A의 S3 + CloudFront ---
AWS_REGION={{ aws_region }}
AWS_ACCESS_KEY_ID={{ s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
AWS_S3_BUCKET={{ s3_bucket }}
CLOUDFRONT_DOMAIN={{ cloudfront_domain }}
