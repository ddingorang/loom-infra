# Ansible이 생성한 파일입니다. 직접 수정하지 말고 group_vars를 고친 뒤 server.yml을 다시 실행하세요.
# backend_ai/app/core/config.py(pydantic-settings)가 읽는 값
APP_NAME={{ ai_name }}
DEBUG={{ ai_debug }}
TZ=Asia/Seoul

# 추천 후보 조회용 RDS 접속 (백엔드와 같은 DB/계정, psycopg 연결 문자열)
# 계정/비밀번호의 특수문자(@ : / # 등)는 URL 인코딩해야 연결 문자열이 깨지지 않음
DATABASE_URL=postgresql://{{ db_user | urlencode | replace('/', '%2F') }}:{{ db_password | urlencode | replace('/', '%2F') }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode={{ db_sslmode }}

# 퍼스널 컬러 진단 가중치 (호스트 {{ ai_models_dir }} → 컨테이너 {{ ai_models_mount }}, 읽기 전용)
COLOR_CHECKPOINT={{ ai_models_mount }}/{{ ai_color_checkpoint }}
FACER_WEIGHTS_DIR={{ ai_models_mount }}/facer
COLOR_DEVICE={{ ai_color_device }}
