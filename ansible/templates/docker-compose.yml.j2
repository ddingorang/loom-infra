# DB는 계정 B의 RDS를 사용하므로 이 스택에는 DB 컨테이너가 없습니다.
name: {{ compose_project_name }}

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "5"

services:
  app:
    image: ${ECR_REPO}:${IMAGE_TAG}
    container_name: {{ app_name }}
    restart: unless-stopped
    env_file:
      - ./app.env
    ports:
      # Nginx만 접근하도록 루프백에만 바인딩
      - "127.0.0.1:{{ app_port }}:8080"
    depends_on:
      redis:
        condition: service_healthy
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network

  # Redis. 호스트 포트를 열지 않고 같은 네트워크의 app이 redis:6379 로 접속합니다.
  redis:
    image: {{ redis_image }}
    container_name: {{ compose_project_name }}-redis
    restart: unless-stopped
    command: ["redis-server", "/usr/local/etc/redis/redis.conf"]
    volumes:
      - ./redis.conf:/usr/local/etc/redis/redis.conf:ro
      - {{ redis_data_dir }}:/data
    healthcheck:
      # 비밀번호 없이 보낸 PING 의 NOAUTH 응답도 '서버가 떠 있음'으로 본다 (비밀번호를 compose 파일에 남기지 않기 위해)
      test: ["CMD-SHELL", "redis-cli ping 2>&1 | grep -qE 'PONG|NOAUTH'"]
      interval: 10s
      timeout: 3s
      retries: 5
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network
{% if ai_enabled | default(false) | bool %}

  # AI 서버(FastAPI). 외부 포트를 열지 않고 같은 네트워크의 app이 http://ai:{{ ai_port }} 로 호출합니다.
  ai:
    image: ${AI_ECR_REPO}:${AI_IMAGE_TAG}
    container_name: {{ ai_name }}
    restart: unless-stopped
    env_file:
      - ./ai.env
    volumes:
      # 진단 모델 가중치. 이미지에 굽지 않고 server.yml이 복사한 파일을 읽기 전용으로 마운트
      - {{ ai_models_dir }}:{{ ai_models_mount }}:ro
    expose:
      - "{{ ai_port }}"
    healthcheck:
      # python:3.12-slim에는 curl이 없어 파이썬으로 확인
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ ai_port }}/health', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network
{% endif %}
{% if monitoring_enabled | bool %}

  # ---------- 모니터링 (S15P31A104-107) ----------
  # 외부 공개는 Grafana 하나 (127.0.0.1 바인딩 → Nginx /grafana/). Prometheus · exporter 는 호스트 포트 없이 이 네트워크 안에서만 통신
  prometheus:
    image: {{ prometheus_image }}
    container_name: {{ compose_project_name }}-prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention_time }}
      - --storage.tsdb.retention.size={{ prometheus_retention_size }}
      # Grafana 를 거치지 않는 원본 화면은 SSH 터널로만 연다 (docs/OPERATIONS.md)
      - --web.external-url=http://localhost:9090/
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ prometheus_data_dir }}:/prometheus
    expose:
      - "9090"
    mem_limit: {{ prometheus_mem_limit }}
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network

  grafana:
    image: {{ grafana_image }}
    container_name: {{ compose_project_name }}-grafana
    restart: unless-stopped
    env_file:
      - ./grafana.env   # 관리자 비밀번호 (0600)
    environment:
      GF_SERVER_ROOT_URL: "{{ grafana_root_url }}"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_COOKIE_SECURE: "{{ 'true' if enable_https | bool else 'false' }}"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
    volumes:
      - {{ grafana_data_dir }}:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "127.0.0.1:{{ grafana_port }}:3000"
    depends_on:
      - prometheus
    mem_limit: {{ grafana_mem_limit }}
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network

  # 호스트 CPU · 메모리 · 디스크. 호스트 루트를 읽기 전용으로 보고, 컨테이너 내부 파일시스템은 제외
  node-exporter:
    image: {{ node_exporter_image }}
    container_name: {{ compose_project_name }}-node-exporter
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+)($|/)
    pid: host
    volumes:
      - /:/host:ro,rslave
    expose:
      - "9100"
    mem_limit: {{ exporter_mem_limit }}
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network

  # 컨테이너별 CPU · 메모리. 수집 부하를 줄이려고 docker 컨테이너만, 30초 간격, 필요한 지표만
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: {{ compose_project_name }}-cadvisor
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --whitelisted_container_labels=com.docker.compose.service
      - --enable_metrics=cpu,memory,network,diskIO,oom_event
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    expose:
      - "8080"
    mem_limit: {{ cadvisor_mem_limit }}
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network

  redis-exporter:
    image: {{ redis_exporter_image }}
    container_name: {{ compose_project_name }}-redis-exporter
    restart: unless-stopped
    env_file:
      - ./redis-exporter.env   # REDIS_PASSWORD (0600)
    environment:
      REDIS_ADDR: redis://redis:6379
    expose:
      - "9121"
    depends_on:
      redis:
        condition: service_healthy
    mem_limit: {{ exporter_mem_limit }}
    logging: *default-logging
    networks:
      - {{ compose_project_name }}-network
{% endif %}

networks:
  {{ compose_project_name }}-network:
    driver: bridge
